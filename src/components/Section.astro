---
interface Props {
    title?: string;
}

const { title = undefined } = Astro.props;
---

<section>
    {title && <h1>{title}</h1>}
    <div class="section-content">
        <slot />
    </div>
</section>
<style>
    section {
        background-color: var(--section-background-colour);
        padding: var(--section-padding);
        border-top: var(--section-border);
        border-bottom: var(--section-border);
        :first-child {
            margin-top: 0;
        }
        :last-child {
            margin-bottom: 0;
        }
        h1 {
            font-size: 24px;
            border: 2px solid var(--accent-colour);
            border-style: inset;
            padding: 10px;
            background-color: #171717;
            text-align: center;
        }
        .section-content {
            padding: 0 10px;
        }
        a {
            color: var(--accent-colour);
        }
    }
</style>
