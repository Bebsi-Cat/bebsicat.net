---
interface Props {
    showMarquee: boolean;
}

const { showMarquee = false } = Astro.props;
---

<header>
    <figure class="header-image">
        <img id="header-image" alt="Header image not loaded" />
        <figcaption id="credit">
            Dmitry Abukaev (Milsim visions x 02)
        </figcaption>
    </figure>
    <script is:inline>
        var theme = window.__theme;
        const creditText = document.getElementById("credit");
        const headerImg = document.getElementById("header-image");
        headerImg.src = `/header-images/${theme.headerImage}`;
        creditText.textContent = theme.credit;
    </script>
    {showMarquee && (
        <div id="marquee-container">
            <marquee>
                <span>WELCOME TO MY SITE!</span>
                <span>Its currently heavily under-construction X3</span>
            </marquee>
        </div>
    )}
</header>

<style>
    header {
        max-width: calc(1320px - var(--section-gap) * 2);
        display: flex;
        flex-direction: column;
        gap: var(--section-gap);
    }
    marquee {
        span {
            margin: 0 10px;
        }
    }
    .header-image {
        position: relative;
        margin: 0;
        display: inline-block;
        #header-image {
            display: inline-block;
            width: calc(1320px - var(--section-gap) * 2);
            height: 300px;
            object-fit: cover;
            object-position: 50% 50%;
        }
    }
    #credit {
        position: absolute;
        right: 10px;
        bottom: 10px;
        padding: 10px;
    }
    #marquee-container {
        background-color: var(--section-background-colour);
        padding: var(--section-padding);
        box-sizing: border-box;
        border-top: var(--section-border);
        border-bottom: var(--section-border);
    }
</style>
