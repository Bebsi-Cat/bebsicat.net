---
import ThemeSwitcher from "./ThemeSwitcher.astro";
---

<aside>
    <h2>SITEMAP</h2>
    <nav>
        <ul>
            <li>
                <a href="/">Home</a>
            </li>
            <li>
                <a href="/blog">Blog</a>
            </li>
            <li>
                <a href="/projects">Projects</a>
            </li>
            <li>
                <a href="/gallery">Gallery</a>
            </li>
            <li>
                <a href="/snep">Sneps...</a>
            </li>
        </ul>
    </nav>
    <h2>TO DO!</h2>
    <p>- Add Projects/gallery</p>
    <p>- Add content to pages</p>
    <h2>Theme</h2>
    <ThemeSwitcher />
</aside>
<style>
    aside {
        min-width: 210px;
        height: 100%;
        background-color: var(--section-background-colour);
        padding: var(--section-padding);
        border-top: var(--section-border);
        border-bottom: var(--section-border);

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            text-align: center;
        }
        h2 {
            border: 2px solid var(--accent-colour);
            border-style: inset;
            padding: 10px;
            background-color: var(--heading-background);
        }
        nav {
            background-color: var(--heading-background);
            padding: 15px 0;
            border-top: var(--section-border);
            border-bottom: var(--section-border);
            ul {
                list-style-type: "🢥";
                margin: 0;
                li {
                    padding: 3px 3px 3px 7px;
                    a {
                        text-decoration: none;
                        transition: transform 0.2s;
                        display: inline-block;
                        &:hover {
                            text-decoration: underline;
                            transform: scale(1.2);
                        }
                    }
                }
            }
        }
    }
    aside > :first-child {
        margin-top: 0;
    }
    aside > :last-child {
        margin-bottom: 0;
    }
</style>
