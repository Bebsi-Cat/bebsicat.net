---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
import "@fontsource-variable/sixtyfour";
import "@fontsource/tomorrow";
import themes from "../assets/themes.json" with { type: "json" };
const defaultThemeId = themes[0].id;
interface Props {
    title: string;
    description: string;
    showMarquee?: boolean;
}
const { title, description, showMarquee = false } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/x-icon" href="/favicon.png" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Bebsi's YAPPIN"
            href={new URL("rss.xml", Astro.site)}
        />
        <title>{title} | bebsi</title>
        <meta name="description" content={description} />
        <script is:inline define:vars={{ themes, defaultThemeId }}>
            (function () {
                var id;
                try {
                    id = localStorage.getItem("theme");
                } catch (error) {
                    console.error(error);
                }
                var theme =
                    themes.find(function (t) {
                        return t.id === id;
                    }) ||
                    themes.find(function (t) {
                        return t.id === defaultThemeId;
                    });
                var root = document.documentElement;
                root.dataset.theme = theme.id;
                root.style.setProperty("--accent-colour", theme.accentColour);
                window.__theme = theme;
            })();
        </script>
    </head>
    <body>
        <Header showMarquee={showMarquee} />
        <div id="content">
            <Sidebar />
            <main>
                <slot />
            </main>
        </div>
        <slot name="before-footer" />
        <Footer />
    </body>
</html>

<style>
    html {
        background-color: black;
        background-image: url("/Hexagon_Tiling.svg");
        background-repeat: repeat;
        background-size: calc(100vw / 6) auto;
    }
    body {
        margin: 0 auto;
        display: flex;
        gap: var(--section-gap);
        flex-direction: column;
        max-width: 1320px;
        padding: 0 var(--section-gap) var(--section-gap) var(--section-gap);
        min-height: 100vh;
        box-sizing: border-box;
    }
    #content {
        display: flex;
        flex-direction: row;
        gap: var(--section-gap);
        margin-bottom: auto;
    }
    main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: var(--section-gap);
    }
</style>
